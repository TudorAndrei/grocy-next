{
  "name": "grocy-next-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.json --noEmit",
    "preview": "vite preview",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix --deny-warnings .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "check": "npm run lint && npm run format:check && npm run typecheck"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.45",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "gettext-translator": "3.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sprintf-js": "1.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.90.0",
    "@tanstack/router-plugin": "^1.168.47",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sprintf-js": "^1.1.4",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "30.1.3",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "5.0.5"
  }
}
