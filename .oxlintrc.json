{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "env": {
    "browser": true
  },
  "globals": {
    "Each": "readonly"
  },
  "ignorePatterns": ["frontend/.nsh/**", "frontend/dist/**", "frontend/generated/**"]
}
