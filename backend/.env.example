GROCY_DEBUG=false
GROCY_USE_NATIVE_PHP=false
GROCY_CURRENCY=USD
GROCY_CALENDAR_FIRST_DAY_OF_WEEK=
GROCY_MEAL_PLAN_FIRST_DAY_OF_WEEK=
GROCY_ENTRY_PAGE=stock
GROCY_BASE_PATH=
GROCY_BASE_URL=/
GROCY_DEFAULT_PERMISSIONS=["ADMIN"]
GROCY_DEFAULT_USER_SETTINGS={}
GROCY_AUTH_MODE=default
GROCY_DISABLE_AUTH=false
GROCY_REVERSE_PROXY_AUTH_HEADER=Remote-User
GROCY_REVERSE_PROXY_AUTH_USE_ENV=false
GROCY_LDAP_ADDRESS=
GROCY_LDAP_BASE_DN=
GROCY_LDAP_BIND_DN=
GROCY_LDAP_BIND_PW=
GROCY_LDAP_UID_ATTR=
GROCY_LDAP_USER_FILTER=
GROCY_LDAP_START_TLS=false
GROCY_LDAP_CONNECT_TIMEOUT=5
GROCY_LDAP_RECEIVE_TIMEOUT=10
GROCY_HOST=127.0.0.1
GROCY_PORT=8000
GROCY_DATABASE_URL=sqlite+aiosqlite:///data/grocy.db
GROCY_DATABASE_BUSY_TIMEOUT_MS=5000
GROCY_DATABASE_WAL=true
GROCY_API_KEY_HEADER=GROCY-API-KEY
GROCY_DEV_OPEN_API_KEY=dev-key
GROCY_AUTO_CREATE_SCHEMA=true
GROCY_SEED_DEMO_DATA=true
GROCY_GROCY_BASELINE=v4.5.0
GROCY_MCP_ENABLED=true
GROCY_MCP_API_KEY=
GROCY_FILES_ROOT=data/files
GROCY_MAX_UPLOAD_BYTES=20971520
GROCY_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
GROCY_BARCODE_PROVIDER_URL=https://world.openfoodfacts.org/api/v2/product/{barcode}.json
GROCY_LABEL_PRINTER_WEBHOOK=
GROCY_LABEL_PRINTER_RUN_SERVER=true
GROCY_LABEL_PRINTER_HOOK_JSON=true
GROCY_LABEL_PRINTER_PARAMS={"font_family":"Source Sans Pro (Regular)"}
GROCY_THERMAL_PRINTER_HOST=
GROCY_THERMAL_PRINTER_PORT=9100
