{
  "name": "grocy-next-tools",
  "private": true,
  "scripts": {
    "lint": "oxlint --deny-warnings frontend",
    "lint:fix": "oxlint --deny-warnings --fix frontend",
    "format": "oxfmt frontend package.json .oxlintrc.json .oxfmtrc.json",
    "format:check": "oxfmt --check frontend package.json .oxlintrc.json .oxfmtrc.json"
  },
  "devDependencies": {
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
